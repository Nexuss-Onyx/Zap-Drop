{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zapdrop",
  "version": "2.0.3",
  "identifier": "com.zapdrop.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zapdrop",
        "width": 460,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' data: 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/thumbs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
